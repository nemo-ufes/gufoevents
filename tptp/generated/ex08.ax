% deposit1 changedBalanceInEurosTo "1250.00"
fof(ex08_fact_134, axiom, ex_changedBalanceInEurosTo(ex_deposit1, v_1250_00)).
% deposit2 changedBalanceInEurosTo "2000.00"
fof(ex08_fact_135, axiom, ex_changedBalanceInEurosTo(ex_deposit2, v_2000_00)).
% depositCorrection changedBalanceInEurosTo "1325.00"
fof(ex08_fact_136, axiom, ex_changedBalanceInEurosTo(ex_depositCorrection, v_1325_00)).
% finalWithdrawal changedBalanceInEurosTo "0.00"
fof(ex08_fact_137, axiom, ex_changedBalanceInEurosTo(ex_finalWithdrawal, v_0_00)).
% openingDeposit changedBalanceInEurosTo "500.00"
fof(ex08_fact_138, axiom, ex_changedBalanceInEurosTo(ex_openingDeposit, v_500_00)).
% withdrawal1 changedBalanceInEurosTo "325.00"
fof(ex08_fact_139, axiom, ex_changedBalanceInEurosTo(ex_withdrawal1, v_325_00)).
% depositCorrection corrects deposit2
fof(ex08_fact_140, axiom, ex_corrects(ex_depositCorrection, ex_deposit2)).
