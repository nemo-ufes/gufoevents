fof(ex07_rng_135, axiom, ! [X, Y] : (ex_involvesPatient(X, Y) => iof(Y, ex_Patient))).
% involvesPhysician rdfs:range Physician
fof(ex07_rng_136, axiom, ! [X, Y] : (ex_involvesPhysician(X, Y) => iof(Y, ex_Physician))).
% Admission rdfs:subClassOf gufoevents:ComplexAchievement
fof(ex07_sub_137, axiom, ! [X] : (iof(X, ex_Admission) => iof(X, ge_ComplexAchievement))).
% AdverseReaction rdfs:subClassOf gufoevents:SimpleAchievement
fof(ex07_sub_138, axiom, ! [X] : (iof(X, ex_AdverseReaction) => iof(X, ge_SimpleAchievement))).
% CareRelationship rdfs:subClassOf gufo:Relator
fof(ex07_sub_139, axiom, ! [X] : (iof(X, ex_CareRelationship) => iof(X, gufo_Relator))).
% ClinicalEpisode rdfs:subClassOf gufo:Event
fof(ex07_sub_140, axiom, ! [X] : (iof(X, ex_ClinicalEpisode) => iof(X, gufo_Event))).
% Discharge rdfs:subClassOf gufoevents:ComplexAchievement
fof(ex07_sub_141, axiom, ! [X] : (iof(X, ex_Discharge) => iof(X, ge_ComplexAchievement))).
% DrugAllergy rdfs:subClassOf gufo:IntrinsicMode
fof(ex07_sub_142, axiom, ! [X] : (iof(X, ex_DrugAllergy) => iof(X, gufo_IntrinsicMode))).
% Headache rdfs:subClassOf gufo:IntrinsicMode
fof(ex07_sub_143, axiom, ! [X] : (iof(X, ex_Headache) => iof(X, gufo_IntrinsicMode))).
% Inpatient rdfs:subClassOf Patient
fof(ex07_sub_144, axiom, ! [X] : (iof(X, ex_Inpatient) => iof(X, ex_Patient))).
% Outpatient rdfs:subClassOf Patient
fof(ex07_sub_145, axiom, ! [X] : (iof(X, ex_Outpatient) => iof(X, ex_Patient))).
% PainAssessment rdfs:subClassOf gufoevents:QualityValueChange
fof(ex07_sub_146, axiom, ! [X] : (iof(X, ex_PainAssessment) => iof(X, ge_QualityValueChange))).
% PainGrade rdfs:subClassOf gufo:QualityValue
fof(ex07_sub_147, axiom, ! [X] : (iof(X, ex_PainGrade) => iof(X, gufo_QualityValue))).
% PainIntensity rdfs:subClassOf gufo:Quality
fof(ex07_sub_148, axiom, ! [X] : (iof(X, ex_PainIntensity) => iof(X, gufo_Quality))).
% Patient rdfs:subClassOf Person
fof(ex07_sub_149, axiom, ! [X] : (iof(X, ex_Patient) => iof(X, ex_Person))).
% Person rdfs:subClassOf gufo:Object
fof(ex07_sub_150, axiom, ! [X] : (iof(X, ex_Person) => iof(X, gufo_Object))).
% Physician rdfs:subClassOf Person
fof(ex07_sub_151, axiom, ! [X] : (iof(X, ex_Physician) => iof(X, ex_Person))).
% SymptomOnset rdfs:subClassOf gufoevents:EndurantCreation
fof(ex07_sub_152, axiom, ! [X] : (iof(X, ex_SymptomOnset) => iof(X, ge_EndurantCreation))).
% SymptomResolution rdfs:subClassOf gufoevents:EndurantTermination
fof(ex07_sub_153, axiom, ! [X] : (iof(X, ex_SymptomResolution) => iof(X, ge_EndurantTermination))).
% TreatmentCourse rdfs:subClassOf gufo:Event
fof(ex07_sub_154, axiom, ! [X] : (iof(X, ex_TreatmentCourse) => iof(X, gufo_Event))).
% involvesPatient rdfs:subPropertyOf gufo:mediates
fof(ex07_subp_155, axiom, ! [X, Y] : (ex_involvesPatient(X, Y) => gufo_mediates(X, Y))).
% involvesPhysician rdfs:subPropertyOf gufo:mediates
fof(ex07_subp_156, axiom, ! [X, Y] : (ex_involvesPhysician(X, Y) => gufo_mediates(X, Y))).
% Inpatient owl:disjointWith Outpatient
fof(ex07_disj_157, axiom, ! [X] : ~(iof(X, ex_Inpatient) & iof(X, ex_Outpatient))).
% owl:AllDifferent none mild
fof(ex07_diff_158, axiom, ex_none != ex_mild).
% owl:AllDifferent none moderate
fof(ex07_diff_159, axiom, ex_none != ex_moderate).
% owl:AllDifferent none severe
fof(ex07_diff_160, axiom, ex_none != ex_severe).
% owl:AllDifferent mild moderate
fof(ex07_diff_161, axiom, ex_mild != ex_moderate).
% owl:AllDifferent mild severe
fof(ex07_diff_162, axiom, ex_mild != ex_severe).
% owl:AllDifferent moderate severe
fof(ex07_diff_163, axiom, ex_moderate != ex_severe).
% PainGrade owl:equivalentClass [ owl:oneOf ( ... ) ]
fof(ex07_oneof_164, axiom, ! [X] : (iof(X, ex_PainGrade) <=> (X = ex_none | X = ex_mild | X = ex_moderate | X = ex_severe))).
% anasCare involvesPatient ana
fof(ex07_fact_165, axiom, ex_involvesPatient(ex_anasCare, ex_ana)).
% anasCare involvesPhysician bruno
fof(ex07_fact_166, axiom, ex_involvesPhysician(ex_anasCare, ex_bruno)).
