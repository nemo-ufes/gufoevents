fof(ex07_log_145, axiom, ! [X, Y] : (gufo_historicallyDependsOn(X, Y) => ((X = ex_anasAdmission & Y = ex_onsetBundle) | (X = ex_anasDischarge & Y = ex_initialPainSevere) | (X = ex_anasDischarge & Y = ex_painDropsToMild) | (X = ex_anasDischarge & Y = ex_painDropsToModerate) | (X = ex_anasDischarge & Y = ex_symptomResolutionBundle) | (X = ex_anasTreatment & Y = ex_anasAdmission) | (X = ex_anasTreatment & Y = ex_onsetBundle) | (X = ex_painDropsToMild & Y = ex_initialPainSevere) | (X = ex_painDropsToMild & Y = ex_painDropsToModerate) | (X = ex_painDropsToModerate & Y = ex_initialPainSevere) | (X = ex_symptomResolutionBundle & Y = ex_initialPainSevere) | (X = ex_symptomResolutionBundle & Y = ex_painDropsToMild) | (X = ex_symptomResolutionBundle & Y = ex_painDropsToModerate)))).
% completion of Classification
fof(ex07_log_146, axiom, ! [X] : (iof(X, ge_Classification) => (X = ex_anaBecomesInpatient | X = ex_anaBecomesOutpatient | X = ex_anaBecomesPatient))).
% completion of Declassification
fof(ex07_log_147, axiom, ! [X] : (iof(X, ge_Declassification) => (X = ex_anaCeasesToBeInpatient))).
% completion of QualityValueChange
fof(ex07_log_148, axiom, ! [X] : (iof(X, ge_QualityValueChange) => (X = ex_initialPainSevere | X = ex_painDropsToMild | X = ex_painDropsToModerate))).
% completion of EndurantCreation
fof(ex07_log_149, axiom, ! [X] : (iof(X, ge_EndurantCreation) => (X = ex_careCreation | X = ex_headacheOnset | X = ex_intensityCreation))).
% completion of EndurantTermination
fof(ex07_log_150, axiom, ! [X] : (iof(X, ge_EndurantTermination) => (X = ex_headacheResolution | X = ex_intensityTermination))).
% completion of EndurantChange
fof(ex07_log_151, axiom, ! [X] : (iof(X, ge_EndurantChange) => (X = ex_anaBecomesInpatient | X = ex_anaBecomesOutpatient | X = ex_anaBecomesPatient | X = ex_anaCeasesToBeInpatient | X = ex_initialPainSevere | X = ex_painDropsToMild | X = ex_painDropsToModerate))).
% no ParthoodChange in this log
fof(ex07_log_152, axiom, ! [X] : ~iof(X, ge_ParthoodChange)).
% no PartIncorporation in this log
fof(ex07_log_153, axiom, ! [X] : ~iof(X, ge_PartIncorporation)).
% no PartSeparation in this log
fof(ex07_log_154, axiom, ! [X] : ~iof(X, ge_PartSeparation)).
