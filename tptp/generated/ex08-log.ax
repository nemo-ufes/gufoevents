fof(ex08_log_148, axiom, ! [X, Y] : (gufo_historicallyDependsOn(X, Y) => ((X = ex_closure & Y = ex_deposit1) | (X = ex_closure & Y = ex_deposit2) | (X = ex_closure & Y = ex_depositCorrection) | (X = ex_closure & Y = ex_openingDeposit) | (X = ex_closure & Y = ex_withdrawal1) | (X = ex_deposit1 & Y = ex_openingDeposit) | (X = ex_deposit2 & Y = ex_deposit1) | (X = ex_deposit2 & Y = ex_openingDeposit) | (X = ex_depositCorrection & Y = ex_deposit1) | (X = ex_depositCorrection & Y = ex_deposit2) | (X = ex_depositCorrection & Y = ex_openingDeposit) | (X = ex_freeze & Y = ex_accountBecomesActive) | (X = ex_unfreeze & Y = ex_accountBecomesActive) | (X = ex_unfreeze & Y = ex_freeze) | (X = ex_withdrawal1 & Y = ex_deposit1) | (X = ex_withdrawal1 & Y = ex_deposit2) | (X = ex_withdrawal1 & Y = ex_depositCorrection) | (X = ex_withdrawal1 & Y = ex_openingDeposit)))).
% completion of Classification
fof(ex08_log_149, axiom, ! [X] : (iof(X, ge_Classification) => (X = ex_accountBecomesActive | X = ex_accountBecomesActiveAgain | X = ex_accountBecomesClosed | X = ex_accountBecomesFrozen))).
% completion of Declassification
fof(ex08_log_150, axiom, ! [X] : (iof(X, ge_Declassification) => (X = ex_accountCeasesActive | X = ex_accountCeasesActiveOnClosure | X = ex_accountCeasesFrozen))).
% completion of QualityValueChange
fof(ex08_log_151, axiom, ! [X] : (iof(X, ge_QualityValueChange) => (X = ex_deposit1 | X = ex_deposit2 | X = ex_depositCorrection | X = ex_finalWithdrawal | X = ex_openingDeposit | X = ex_withdrawal1))).
% completion of EndurantCreation
fof(ex08_log_152, axiom, ! [X] : (iof(X, ge_EndurantCreation) => (X = ex_accountCreation | X = ex_balanceCreation))).
% completion of EndurantTermination
fof(ex08_log_153, axiom, ! [X] : (iof(X, ge_EndurantTermination) => (X = ex_balanceTermination))).
% completion of EndurantChange
fof(ex08_log_154, axiom, ! [X] : (iof(X, ge_EndurantChange) => (X = ex_accountBecomesActive | X = ex_accountBecomesActiveAgain | X = ex_accountBecomesClosed | X = ex_accountBecomesFrozen | X = ex_accountCeasesActive | X = ex_accountCeasesActiveOnClosure | X = ex_accountCeasesFrozen | X = ex_deposit1 | X = ex_deposit2 | X = ex_depositCorrection | X = ex_finalWithdrawal | X = ex_openingDeposit | X = ex_withdrawal1))).
% no ParthoodChange in this log
fof(ex08_log_155, axiom, ! [X] : ~iof(X, ge_ParthoodChange)).
% no PartIncorporation in this log
fof(ex08_log_156, axiom, ! [X] : ~iof(X, ge_PartIncorporation)).
% no PartSeparation in this log
fof(ex08_log_157, axiom, ! [X] : ~iof(X, ge_PartSeparation)).
